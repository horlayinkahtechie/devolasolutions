# Copy this to .env.local and fill in real values. Never commit .env.local —
# it's already gitignored.

# ── Contact form (already in use) ───────────────────────────────────────
RESEND_API_KEY=

# ── Devola Academy (education platform) ─────────────────────────────────
# Phase 1 — Firebase (Firestore + Auth). Create a Firebase project at
# https://console.firebase.google.com, then:
#   - Build > Authentication > Sign-in method: enable "Email link
#     (passwordless)" and "Email/Password" (the latter is for the admin
#     account only — see scripts/edu-set-admin.js).
#   - Authentication > Settings > Authorized domains: add
#     edu.devolasolutions.com (and edu.localhost for local dev).
#   - Project settings > General: register a Web app, copy the config
#     below (NEXT_PUBLIC_* — safe to expose client-side, these are not
#     secrets, Firestore/Auth security comes from rules + Admin SDK).
#   - Project settings > Service accounts > Generate new private key:
#     download the JSON, copy the three FIREBASE_* values below from it.
#   - (Optional, for admin MFA) Authentication > Sign-in method > Advanced:
#     enable Multi-factor Authentication (requires the Identity Platform
#     upgrade — still has a free tier, but has its own pricing beyond it).
#
# Public web app config (client SDK — app/edu/_lib/firebase-client.js):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account (Admin SDK — server only, app/edu/_lib/firebase-admin.js).
# FIREBASE_PRIVATE_KEY: paste it with literal \n for newlines if your env
# var tooling can't store real line breaks (Vercel's dashboard can store
# multi-line values directly, so this only matters for some setups).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The public base URL the edu platform is reachable at — used to build the
# magic-link sign-in URL. http://edu.localhost:3000 works for local dev.
NEXT_PUBLIC_EDU_BASE_URL=https://edu.devolasolutions.com

# ── Phase 4 — Payments (Paystack) — not used yet ────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Phase 2/5 — Video (Cloudflare R2) — not used yet ─────────────────────
# Chose R2 over Cloudflare Stream: zero egress fees (video delivery is
# bandwidth-heavy, that's the cost that actually adds up), and it's
# S3-compatible object storage + our own signed URLs rather than a managed
# video SaaS. Get these from the Cloudflare dashboard -> R2 -> Manage R2 API
# Tokens (a different page from the general "API Tokens" one Stream would
# have used) -> Create API Token, scoped to Object Read & Write on the
# bucket you create for course videos.
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Shown alongside the token when you create it; same shape every time:
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=

